# Copy this file to .env for LOCAL DEVELOPMENT ONLY and never commit it.
# This server does not load .env automatically; start it with:
#   node --env-file=.env dist/cli.js
# GUI MCP clients usually cannot read your shell environment; put the token in
# the client's server config instead, or launch through a wrapper that sets it.
# See the README configuration section.

# Required for GitHub access. Use a read-only token limited to the repositories
# you want to inspect. Never put a real token in a tracked file.
GITHUB_TOKEN=

# Optional. Defaults to https://api.github.com. Must be HTTPS; plain HTTP is
# accepted only for localhost development.
# GitHub Enterprise example: https://ghe.example.com/api/v3
GITHUB_API_BASE_URL=https://api.github.com

# Optional default log excerpt size in characters (500-20000, default 6000).
GH_ACTION_INSPECTOR_LOG_CHARS=6000

# Optional request timeout in milliseconds (1000-60000, default 15000).
GH_ACTION_INSPECTOR_TIMEOUT_MS=15000

# Optional non-sensitive stderr diagnostics. Never prints tokens or log bodies.
GH_ACTION_INSPECTOR_DEBUG=false

# Optional ADDITIVE redaction patterns, comma or newline separated. Built-in
# safety patterns cannot be disabled. Each pattern is capped at 200 characters.
GH_ACTION_INSPECTOR_EXTRA_REDACTION_PATTERNS=
